<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Registration Successful</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            font-family: Arial, sans-serif;
            background: linear-gradient(
                135deg,
                #667eea,
                #764ba2,
                #f093fb
            );
            padding: 20px;
        }

        .card {
            width: 100%;
            max-width: 600px;
            background: white;
            padding: 35px;
            border-radius: 20px;
            box-shadow: 0 15px 40px rgba(0, 0, 0, 0.2);
        }

        .success {
            text-align: center;
            color: #16a34a;
            font-size: 32px;
            margin-bottom: 10px;
        }

        .subtitle {
            text-align: center;
            color: #555;
            margin-bottom: 30px;
        }

        .details {
            background: #f8f9ff;
            padding: 20px;
            border-radius: 12px;
            margin-bottom: 25px;
        }

        .details p {
            margin: 12px 0;
            color: #333;
        }

        .skills {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin-top: 8px;
        }

        .skill {
            background: #667eea;
            color: white;
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 14px;
        }

        .storage {
            background: #dcfce7;
            color: #166534;
            padding: 12px;
            border-radius: 10px;
            text-align: center;
            margin-bottom: 20px;
        }

        .buttons {
            display: flex;
            gap: 10px;
            justify-content: center;
            flex-wrap: wrap;
        }

        a {
            text-decoration: none;
            padding: 12px 20px;
            border-radius: 10px;
            color: white;
            background: #667eea;
            transition: 0.3s;
        }

        a:hover {
            background: #4f46e5;
            transform: translateY(-2px);
        }

        @media (max-width: 600px) {
            .card {
                padding: 25px;
            }

            .success {
                font-size: 26px;
            }
        }
    </style>
</head>

<body>

    <div class="card">

        <h1 class="success">Registration Successful! 🎉</h1>

        <p class="subtitle">
            Your form has been successfully validated by the server.
        </p>

        <div class="details">

            <p>
                <strong>Registration ID:</strong>
                <%= registration.id %>
            </p>

            <p>
                <strong>Name:</strong>
                <%= registration.name %>
            </p>

            <p>
                <strong>Email:</strong>
                <%= registration.email %>
            </p>

            <p>
                <strong>Age:</strong>
                <%= registration.age %>
            </p>

            <p>
                <strong>Phone:</strong>
                <%= registration.phone %>
            </p>

            <p>
                <strong>Gender:</strong>
                <%= registration.gender %>
            </p>

            <p>
                <strong>Skills:</strong>
            </p>

            <div class="skills">
                <% registration.skills.forEach(function(skill) { %>
                    <span class="skill">
                        <%= skill %>
                    </span>
                <% }); %>
            </div>

        </div>

        <div class="storage">
            ✓ Registration temporarily stored on the server
        </div>

        <div class="buttons">
            <a href="/">Register Another User</a>
            <a href="/registrations">View Stored Data</a>
        </div>

    </div>

</body>
</html>